# --- Flask ---
FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_HOURS=24

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://ucc:ucc@localhost:5432/ucc_findit

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Email OTP ---
# Set ENFORCE_UCC_DOMAIN=true only AFTER the official UCC email domain has been confirmed.
ENFORCE_UCC_DOMAIN=false
UCC_EMAIL_DOMAINS=stu.ucc.edu.gh,ucc.edu.gh
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# --- SMTP (leave SMTP_HOST empty to use development console logging) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@uccfindit.example
