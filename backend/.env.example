# --- Flask ---
FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_HOURS=24

# --- Database ---
# Local development (SQLite, no server required):
# DATABASE_URL=sqlite:///uccfindit.db
# Staging / production (PostgreSQL):
DATABASE_URL=postgresql+psycopg://ucc:ucc@localhost:5432/ucc_findit

# --- CORS ---
CORS_ORIGINS=http://localhost:5174

# --- UCC email domain ---
# Set ENFORCE_UCC_DOMAIN=true only AFTER the official UCC email domain has been confirmed.
ENFORCE_UCC_DOMAIN=false
UCC_EMAIL_DOMAINS=stu.ucc.edu.gh,ucc.edu.gh
