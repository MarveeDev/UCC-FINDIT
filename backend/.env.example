# --- Flask ---
FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_HOURS=24

# --- Database ---
# Local development (SQLite, no server required):
# DATABASE_URL=sqlite:///uccfindit.db
# Staging / production (PostgreSQL):
DATABASE_URL=postgresql+psycopg://ucc:ucc@localhost:5432/ucc_findit

# --- CORS ---
CORS_ORIGINS=http://localhost:5174

# --- OTP verification ---
# Set ENFORCE_UCC_DOMAIN=true only AFTER the official UCC email domain has been confirmed.
ENFORCE_UCC_DOMAIN=false
UCC_EMAIL_DOMAINS=stu.ucc.edu.gh,ucc.edu.gh
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# --- Email delivery (Resend) ---
# Resend API key (starts with "re_"). Required in production; leave empty for
# development (the OTP is logged to the console instead of being emailed).
RESEND_API_KEY=
# Verified sender address, e.g. "UCC FINDIT <noreply@your-domain.com>".
MAIL_FROM=
# Frontend origin used in verification email links.
FRONTEND_URL=http://localhost:5174
