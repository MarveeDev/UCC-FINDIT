# --- Flask ---
FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_HOURS=24

# --- Database ---
# Local development (SQLite, no server required):
# DATABASE_URL=sqlite:///uccfindit.db
# Staging / production (PostgreSQL):
DATABASE_URL=postgresql+psycopg://ucc:ucc@localhost:5432/ucc_findit

# --- CORS ---
CORS_ORIGINS=http://localhost:5174

# --- UCC email domain ---
# Set ENFORCE_UCC_DOMAIN=true only AFTER the official UCC email domain has been confirmed.
ENFORCE_UCC_DOMAIN=false
UCC_EMAIL_DOMAINS=stu.ucc.edu.gh,ucc.edu.gh

# --- Google Sign-In (OAuth 2.0 / OpenID Connect) ---
# Create an OAuth 2.0 "Web application" client in Google Cloud Console and set
# the callback below as an Authorized redirect URI. Leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/v1/auth/google/callback
# Origin of the single-page app (used to redirect back after Google sign-in).
FRONTEND_URL=http://localhost:5174

# --- Image storage (Cloudinary) ---
# Credentials from the Cloudinary dashboard. Leave empty in local development
# to disable image uploads (the API returns a clear 502 when unconfigured).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder prefix for uploaded images.
CLOUDINARY_FOLDER=ucc-findit/items
