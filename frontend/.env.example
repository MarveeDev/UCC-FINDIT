# UCC FINDIT — frontend environment.
#
# VITE_API_BASE_URL — base URL used by the API client (src/lib/api.ts).
#
#   Development: leave this unset. Vite proxies /api to http://localhost:5000
#   (see vite.config.ts), so the client's default '/api/v1' works automatically.
#
#   Production (e.g. Vercel): set it to the backend origin, for example:
#   VITE_API_BASE_URL=https://<backend>.onrender.com/api/v1
#
# VITE_API_BASE_URL=
